# ─────────────────────────────────────────────────────────────────────────────
# AL Jadwal — environment template
#
#   cp .env.example apps/api/.env      # then fill in the API values
#   cp .env.example apps/web/.env      # then fill in the NEXT_PUBLIC_* values
#
# Defaults below match `docker-compose.yml` so the local stack works out of the
# box. NEVER commit a real .env — only this template is tracked.
#
# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=4000

# Local docker-compose Postgres (host port 5433). Inside the compose network the
# api service overrides this to postgres://postgres:admin123@db:5432/jadwal
DATABASE_URL="postgresql://postgres:admin123@localhost:5433/jadwal?schema=public"
REDIS_URL="redis://localhost:6379"

# ── URLs / CORS (required) ───────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
CORS_ORIGIN="http://localhost:3000"

# ── Auth (required) ──────────────────────────────────────────────────────────
# Must be >= 32 chars. Production refuses to start on weak/placeholder values.
JWT_SECRET="change-me-generate-a-32-byte-hex-secret"
JWT_REFRESH_SECRET="change-me-generate-a-different-32-byte-hex-secret"
COOKIE_SECRET="change-me-generate-a-32-byte-hex-secret"

# ── Google OAuth (required) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# ── Payments — PAY2M (required) ──────────────────────────────────────────────
# Set PAYMENT_ENABLED=false locally to run without a live gateway.
PAYMENT_ENABLED="false"
PAY2M_API_URL="https://sandbox.pay2m.example/api"
PAY2M_MERCHANT_ID="your-merchant-id"
PAY2M_MERCHANT_NAME="AL Jadwal"
PAY2M_SECURED_KEY="your-secured-key"
# Must be non-empty in production — an empty value makes the callback hash forgeable.
PAY2M_SECRET_WORD="your-secret-word"
PAY2M_RETURN_URL="http://localhost:3000/payment/callback"
# Server-to-server confirmation (leave disabled locally)
PAY2M_IPN_CONFIRM_ENABLED="false"
PAY2M_IPN_ALLOWED_IPS=""

# ── Email — Resend (required) ────────────────────────────────────────────────
# Set EMAIL_ENABLED=false locally to skip sending.
EMAIL_ENABLED="false"
RESEND_API_KEY="re_your_api_key"
RESEND_WEBHOOK_SECRET="whsec_your_webhook_signing_secret"
EMAIL_FROM="noreply@example.com"
ADMIN_EMAIL="admin@example.com"

# ── Storage (required) ───────────────────────────────────────────────────────
STORAGE_DRIVER="local"          # "local" for dev, "s3" in production
S3_BUCKET="your-bucket-name"
S3_REGION="eu-central-1"
AWS_REGION="eu-central-1"
CDN_URL=""

# ── Web push — VAPID (required) ──────────────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:admin@example.com"

# ── Signing secrets (required) ───────────────────────────────────────────────
UNSUBSCRIBE_TOKEN_SECRET="change-me-generate-a-32-byte-hex-secret"
REVIEW_HASH_SECRET="change-me-generate-a-32-byte-hex-secret"
BOOKING_OTP_PEPPER="change-me-generate-a-32-byte-hex-secret"

# ── Rate limiting / proxy ────────────────────────────────────────────────────
THROTTLE_ENABLED="true"
# Number of proxy hops in front of the API (0 locally; >0 behind a CDN + LB).
TRUST_PROXY_HOPS=0

# ── Optional ─────────────────────────────────────────────────────────────────
LOG_LEVEL="debug"
ENABLE_HSTS="false"
SENTRY_DSN=""

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND (apps/web) — NEXT_PUBLIC_* are baked in at build time
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_VAPID_KEY="your-vapid-public-key"   # same as VAPID_PUBLIC_KEY
NEXT_PUBLIC_CDN_URL=""

# Server-side (SSR) hop to the API — inside docker-compose this is http://api:4000
API_PROXY_TARGET="http://localhost:4000"
INTERNAL_API_URL="http://localhost:4000"

# Optional analytics / marketing tags (consent-gated; leave blank to disable)
NEXT_PUBLIC_FB_PIXEL_ID=""
NEXT_PUBLIC_GOOGLE_ADS_ID=""
NEXT_PUBLIC_CSP_REPORT_URI=""
