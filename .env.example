# Database
DATABASE_URL="postgresql://user:password@localhost:5432/jadwal?schema=public"

# Application
PORT=4000
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Security Configurations
CORS_ORIGIN="http://localhost:3000"
JWT_SECRET="super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="super-secret-refresh-key-change-in-production"

# Redis (Caching & Sessions)
REDIS_URL="redis://localhost:6379"

# Email / SMTP (Nodemailer config)
MAIL_HOST="smtp.mailtrap.io"
MAIL_USER="your-mailtrap-user"
MAIL_PASS="your-mailtrap-password"
MAIL_FROM="noreply@jadwal.app"

# Third-party Integrations
STRIPE_SECRET_KEY="sk_test_..."
AWS_S3_BUCKET="jadwal-assets"
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="..."
