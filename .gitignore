node_modules/
.pnp
.pnp.js

# Build outputs
dist/
.next/
out/
build/

# Turbo
.turbo/

# Environment variables
.env
.env.*
!.env.example

# Debug logs
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# TypeScript build info
*.tsbuildinfo

# Test artifacts
test-results/
playwright-report/

