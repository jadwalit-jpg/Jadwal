# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
.next/
out/
build/

# Turbo
.turbo/

# Environment variables
.env
.env.*
!.env.example

# Debug logs
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# TypeScript build info
*.tsbuildinfo

# Test artifacts
test-results/
playwright-report/
tests/reports/

# Dev uploads — user-generated content lives on the host filesystem (dev)
# or in S3 (prod). Never store uploaded files in git history.
apps/api/uploads/

# Per-user Claude state — skills + project settings.json ARE committed,
# but per-machine state stays local
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Graphify knowledge graph output (tool artifact)
graphify-out/

# DB migration backups (regenerable from migrations themselves)
backups-*/

# PAY2M integration documentation — vendor doc with NDA risk; never commit
payment.txt
**/payment.txt

# Markdown notes outside committed-docs paths stay local
# (BOOKING_LOGIC.md, README.md, internal scratch notes etc remain local)
*.md
!/DOCUMENTATION.md
!docs/**/*.md
!.antigravity/**/*.md
!.claude/**/*.md
