apps/api/uploads/

# Agent / AI assistant configs (local only)
.claude/
.antigravity/

# Graphify knowledge graph output (tool artifact)
graphify-out/

# Internal docs folder
docs/

# All markdown files except DOCUMENTATION.md
# (keeps the repo clean for handoff — internal notes like CLAUDE.md, BOOKING_LOGIC.md,
#  README.md, API_STRUCTURE.md, SECURITY.md, etc. stay local)
*.md
!/DOCUMENTATION.md
