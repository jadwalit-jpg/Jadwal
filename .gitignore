# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
.next/
out/
build/

# Turbo
.turbo/

# Environment variables
.env
.env.*
!.env.example

# Debug logs
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# TypeScript build info
*.tsbuildinfo

# Test artifacts
test-results/
playwright-report/
tests/reports/

# Dev uploads — user-generated content lives on the host filesystem (dev)
# or in S3 (prod). Never store uploaded files in git history.
apps/api/uploads/

# Internal-only directories — NEVER commit. Contain workspace docs,
# security assessments, project plans, agent skill prompts, and other
# content that's appropriate for private working files but not for the
# repo. History was scrubbed of these on 2026-04-27; the explicit
# excludes below + the negation removals further down keep them out.
.claude/
.antigravity/
docs/
# MCP server config — carries auth/tokens; never commit.
.mcp.json
**/.mcp.json

# AWS OIDC policy templates live as on-disk infra reference, not in
# the repo. Replace the ACCOUNT_ID / org / repo placeholders locally
# when configuring deployment.
.github/aws-oidc-trust-policy.json
.github/aws-oidc-permissions-policy.json

# Graphify knowledge graph output (tool artifact)
graphify-out/

# DB migration backups + dated audit snapshots (regenerable / internal-only)
backups-*/
audit-*/

# PAY2M integration documentation — vendor doc with NDA risk; never commit
payment.txt
**/payment.txt

# Markdown + text notes stay LOCAL by default. The previous policy of
# negating `docs/`, `.antigravity/`, `.claude/` (and carving out
# `DOCUMENTATION.md`) was rolled back on 2026-04-27 — those paths
# were exposing internal working docs (security assessments,
# roadmap, agent skill prompts). History was scrubbed of every
# matching file in EVERY commit; this rule keeps them from sneaking
# back in.
#
# The only narrow exception is `apps/web/public/robots.txt` — the
# Next.js framework needs that file at runtime to serve `/robots.txt`.
*.md
*.txt
!apps/web/public/robots.txt
# SECURITY.md is a public-facing policy required by GitHub's vuln-reporting
# UI and the OpenSSF Scorecard "Security-Policy" check — must be tracked.
# Scoped to ROOT so internal security-implementation docs deeper in the
# tree (e.g. apps/api/SECURITY.md) stay ignored.
!/SECURITY.md
# README.md is the public repo landing doc. Root-scoped so internal *.md deeper
# in the tree (working notes, security-implementation docs) stay ignored.
!/README.md
