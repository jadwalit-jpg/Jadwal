{
  "family": "jadwal-web",
  "taskRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/jadwal-ecs-task-role",
  "executionRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/jadwal-ecs-task-execution",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "volumes": [],
  "placementConstraints": [],
  "containerDefinitions": [
    {
      "name": "web",
      "image": "IMAGE_TAG_PLACEHOLDER",
      "cpu": 0,
      "essential": true,
      "portMappings": [
        { "containerPort": 3000, "hostPort": 3000, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "PORT",     "value": "3000" },
        { "name": "HOSTNAME", "value": "0.0.0.0" }
      ],
      "secrets": [
        { "name": "NODE_ENV",   "valueFrom": "arn:aws:ssm:<AWS_REGION>:<AWS_ACCOUNT_ID>:parameter/jadwal/prod/NODE_ENV" },
        { "name": "AWS_REGION", "valueFrom": "arn:aws:ssm:<AWS_REGION>:<AWS_ACCOUNT_ID>:parameter/jadwal/prod/AWS_REGION" }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "systemControls": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/jadwal-web",
          "awslogs-region": "<AWS_REGION>",
          "awslogs-stream-prefix": "web"
        }
      }
    }
  ]
}
