# ─── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/jadwal?schema=public"
# Per-process pg pool. Default 40 pairs with a PgBouncer sidecar; if running
# direct-to-postgres in tiny dev setups you can drop this to 10.
DB_POOL_MAX=40

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
# Availability cache — per-activity version counter + TTL. Disable with false.
AVAILABILITY_CACHE_ENABLED=true
AVAILABILITY_CACHE_TTL_SEC=180
# C1: Origin-side Redis cache for slow-changing reference data
# (countries / categories / cities / platform-info). TTL bounded [60, 86400].
REFERENCE_CACHE_ENABLED=true
REFERENCE_CACHE_TTL_SEC=3600

# ─── URLs ─────────────────────────────────────────────────────
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
API_URL="http://localhost:4000"
APP_URL="http://localhost:3000"
CSP_CONNECT_SRC="http://localhost:3000,http://localhost:4000"

# ─── Google OAuth ─────────────────────────────────────────────
# Get from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# ─── JWT / Auth ───────────────────────────────────────────────
# Production: use random strings of at least 64 characters
JWT_SECRET="super_secret_key_change_me_in_prod"
JWT_EXPIRATION=900
REFRESH_TOKEN_EXPIRY_DAYS=7
# Absolute session lifetime cap (days). Even if the user keeps rotating
# their refresh token, the session is forcibly logged out after this
# many days from the original login. Bounds the blast radius of a
# stolen refresh token. Default 7.
SESSION_MAX_DAYS=7
LOCKOUT_THRESHOLD=5
LOCKOUT_DURATION_MINUTES=15

# ─── Security ────────────────────────────────────────────────
# HSTS (and CSP `upgrade-insecure-requests`) are gated on this flag.
# Leave OFF for local dev / local prod-build over plain HTTP — turning
# them on poisons WebKit / iOS Safari into auto-upgrading every
# localhost request to HTTPS, which breaks all dev/test traffic with
# SSL connect errors. Real prod (CloudFront / ALB / Cloudflare) sets
# this to true at the task-definition or edge layer.
ENABLE_HSTS=false
BCRYPT_ROUNDS=12
MAX_SESSIONS_PER_USER=5
VERIFICATION_TOKEN_EXPIRY_HOURS=24
PASSWORD_RESET_EXPIRY_HOURS=1

# ─── Booking ─────────────────────────────────────────────────
RESERVATION_WINDOW_MINUTES=15
BOOKING_MAX_ADVANCE_YEARS=2
PENDING_BOOKING_FALLBACK_HOURS=4
REDIS_LOCK_TTL_MS=30000
CANCELLATION_DEADLINE_HOURS=24
# Percent refunded when cancellationPolicy=PARTIAL_REFUND and deadline met.
# FREE_CANCELLATION is always 100%, NON_REFUNDABLE is always 0% — those are
# not configurable by design. Value is clamped to [0, 100] at runtime.
PARTIAL_REFUND_PERCENT=50

# ─── Data Retention (days) ───────────────────────────────────
RETENTION_REFRESH_TOKEN_DAYS=0
RETENTION_SECURITY_LOG_DAYS=90
# Operational audit-log retention. FINANCIAL audit entries (payment /
# payout / loyalty / refund actions) use the longer window below.
RETENTION_AUDIT_LOG_DAYS=180
# §B8 — FINANCIAL audit-log retention. Default 7 years per Qatar PDPL §14
# + GDPR Art.30 + standard financial-records regulation. Lower at your
# own legal risk; jurisdictions with stricter rules may push it higher.
RETENTION_AUDIT_LOG_FINANCIAL_DAYS=2555
RETENTION_EXPIRED_COUPON_DAYS=30
# R4 — days to keep terminal (SENT/FAILED) email-outbox rows before the daily
# cleanup cron prunes them. PENDING rows are never pruned (still being retried).
RETENTION_EMAIL_OUTBOX_DAYS=30

# ─── Vendor payout safety ────────────────────────────────────
# §B4 — minimum days between a vendor changing their bankDetails and
# the next allowed payout request. Closes the "vendor account takeover
# → instant payout to attacker bank" window. Set to 0 to disable
# (NOT recommended in production).
PAYOUT_BANK_DETAILS_COOLDOWN_DAYS=7

# ─── Rate Limiting (global tiers) ────────────────────────────
THROTTLE_ENABLED=true
THROTTLE_SHORT_TTL=60000
THROTTLE_SHORT_LIMIT=20
THROTTLE_LONG_TTL=600000
THROTTLE_LONG_LIMIT=100
THROTTLE_AVAILABILITY_TTL=60000
THROTTLE_AVAILABILITY_LIMIT=30

# ─── Rate Limiting (per-endpoint tiers) ──────────────────────
THROTTLE_MINIMAL_LIMIT=1
THROTTLE_STRICT_LIMIT=3
THROTTLE_AUTH_LIMIT=5
THROTTLE_WRITE_LIMIT=10
THROTTLE_READ_LIMIT=15
THROTTLE_CALLBACK_LIMIT=20
THROTTLE_INTERACTION_LIMIT=30
THROTTLE_VENDOR_LIMIT=60
THROTTLE_ADMIN_LIMIT=120

# ─── Email (Resend) ─────────────────────────────────────────
EMAIL_ENABLED=false
# EMAIL_FROM must be on a domain verified in the Resend dashboard (jadwal.qa).
# A display name improves deliverability — e.g. "Jadwal <noreply@jadwal.qa>".
# Do NOT use a Gmail address — Resend rejects senders on unverified domains.
EMAIL_FROM="noreply@jadwal.qa"
# Resend API key (starts with re_). Required non-empty whenever EMAIL_ENABLED=true
# — EmailService throws at construction otherwise. Store as an SSM SecureString.
RESEND_API_KEY=""
# Owner inbox — receives admin alerts (low volume, internal).
ADMIN_EMAIL="Jadwalqtr@gmail.com"
# Used by the S3 / Secrets Manager SDK clients (not by the email transport).
AWS_REGION="me-central-1"
# Email transport resilience (defaults are paranoid — leave blank in dev):
# RESEND_SEND_TIMEOUT_MS          per-call fetch deadline (default 10000)
# RESEND_BREAKER_FAILURE_THRESHOLD consecutive failures before breaker OPENs (default 10)
# RESEND_BREAKER_OPEN_MS          cooldown before HALF_OPEN probe (default 30000)

# ─── Geo / Proxy ─────────────────────────────────────────────
# Number of trusted proxy hops in front of the API. Behind
# Cloudflare → ALB → ECS that's 2 (CF=1 + ALB=1). Default 0 for
# dev / local / test (no proxy). Production MUST set this — the
# real-IP throttler depends on it. Replaces the old TRUST_PROXY
# boolean (removed 2026-05-01) — single source of truth for
# proxy trust now lives in main.ts.
TRUST_PROXY_HOPS=0

# ─── File Storage ────────────────────────────────────────────
STORAGE_DRIVER="local"
UPLOAD_MAX_SIZE_MB=10
UPLOAD_MAX_DIMENSION=1920
UPLOAD_WEBP_QUALITY=82
S3_BUCKET=""
S3_REGION="me-central-1"
CDN_URL=""

# ─── PAY2M Payment Gateway ──────────────────────────────────
PAY2M_MERCHANT_ID=""
PAY2M_SECURED_KEY=""
# Callback Response_Key secret word. Set this in the PAY2M merchant portal
# FIRST, then put the IDENTICAL value here / in SSM — they must match
# exactly. Required non-empty in production: an empty secret word makes the
# payment callback forgeable (see PaymentService.verifyCallbackHash).
PAY2M_SECRET_WORD=""
PAY2M_MERCHANT_NAME="Jadwal"
PAY2M_API_URL="https://pay.pay2m.com/Ecommerce/api/Transaction"
PAY2M_RETURN_URL="http://localhost:4000/api/payment/callback"
PAY2M_STORE_ID=""
PAYMENT_ENABLED=false
# Resilience (O.92 / O.93). Defaults are paranoid — leave blank in dev.
# PAY2M_TOKEN_TIMEOUT_MS         per-attempt fetch deadline (default 15000)
# PAY2M_BREAKER_FAILURE_THRESHOLD consecutive failures before breaker OPENs (default 10)
# PAY2M_BREAKER_OPEN_MS          cooldown before HALF_OPEN probe (default 30000)
# EXTERNAL_BREAKER_DISABLED      kill switch shared with the email transport (default false)

# ─── Web Push (VAPID) ───────────────────────────────────────
# Generate with: node -e "const wp = require('web-push'); const k = wp.generateVAPIDKeys(); console.log(k);"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:Jadwalqtr@gmail.com"

# ─── Sentry (Error Tracking) ─────────────────────────────────
# Leave SENTRY_DSN empty to disable. In prod: set it in Secrets Manager.
SENTRY_DSN=""
SENTRY_ENVIRONMENT=""            # Defaults to NODE_ENV
SENTRY_RELEASE=""                # Optional — git SHA from CI, used for regression tracking
SENTRY_TRACES_SAMPLE_RATE="0"    # 0..1 — error-only by default
SENTRY_PROFILES_SAMPLE_RATE="0"  # 0..1 — profiling off by default

# ─── Request logger ─────────────────────────────────────────
# Comma-separated path prefixes whose 2xx/3xx responses are NOT logged.
# 4xx/5xx always log. Empty by default (log everything). Use to silence
# high-volume polling endpoints if log volume spikes. Example:
# ACCESS_LOG_SKIP_PATHS=/api/notifications/unread-count,/api/geo/detect
ACCESS_LOG_SKIP_PATHS=""
