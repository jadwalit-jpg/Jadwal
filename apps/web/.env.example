# ═══════════════════════════════════════════════════════════════
# Frontend environment variables.
# NEXT_PUBLIC_* vars are baked into the JS bundle at BUILD time, not runtime.
# Always set these BEFORE running `next build` for production.
# ═══════════════════════════════════════════════════════════════

# ─── API URL ──────────────────────────────────────────────────
# Development: http://localhost:4000/api
# Production:  https://api.yourdomain.com/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ─── Site URL (canonical origin) ───────────────────────────────
# Used by Next.js Metadata `metadataBase` to resolve relative image
# paths in og:image / twitter:image to absolute URLs that social
# scrapers (WhatsApp, Twitter, etc.) can fetch. Optional — defaults
# to http://localhost:3000 in dev.
# Production:  https://jadwal.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Web Push (VAPID) ─────────────────────────────────────────
# Public VAPID key for browser push subscriptions.
# Must match the backend's VAPID_PUBLIC_KEY exactly.
# Generate a fresh pair with: npx web-push generate-vapid-keys
# (private goes in apps/api/.env, public goes here and in apps/web/.env)
NEXT_PUBLIC_VAPID_KEY=your_public_vapid_key

# ─── Server-side (RSC / middleware) — RUNTIME, not build-time ────
# These are read at runtime by Node (Next.js server) — they're NOT
# baked into the client bundle. Setting them in .env (or docker-
# compose env / ECS task def) is enough.

# Internal target for SSR-time `fetch` calls (e.g. /activity/[slug]
# layout fetching activity data for OG metadata). Inside Docker the
# web container can't reach the API via `localhost` — that resolves
# to itself, not the api sibling. Use the docker-network service
# name. For non-docker dev, leave unset; the fetch helper falls
# back to NEXT_PUBLIC_API_URL with localhost->127.0.0.1 (Node 18+
# IPv6-first resolution issue).
# INTERNAL_API_URL=http://api:4000/api

# Same-origin proxy target for Next.js `rewrites()`. The browser
# hits /api/* on the page origin; Next forwards to here server-side
# so auth cookies stay same-origin (works around WebKit ITP cross-
# port cookie drop). Defaults to NEXT_PUBLIC_API_URL minus /api.
# API_PROXY_TARGET=http://api:4000/api

# Gate for HSTS + CSP upgrade-insecure-requests. Leave OFF for local
# dev / local prod-build over plain HTTP — turning on poisons WebKit
# into HTTPS-only mode and breaks every localhost request. Real prod
# sets this true at the edge (Cloudflare / ALB).
# ENABLE_HSTS=true
