# ═══════════════════════════════════════════════════════════════
# Development Dockerfile — Next.js web with hot reload
# Used ONLY by docker-compose.yml for local dev.
# Production uses apps/web/Dockerfile (multi-stage, standalone).
# ═══════════════════════════════════════════════════════════════

FROM node:22-bookworm-slim@sha256:d415caac2f1f77b98caaf9415c5f807e14bc8d7bdea62561ea2fef4fbd08a73c

WORKDIR /app

# ─── Install workspace dependencies ────────────────────────────
# Turborepo hoists shared deps to the root node_modules.
COPY package.json package-lock.json turbo.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

# apps/api has `postinstall: prisma generate` which needs the schema at
# install time. Copy it before npm install so the postinstall hook resolves
# (we don't run the API in this container; the file is just along for the
# ride during workspace install).
COPY apps/api/prisma ./apps/api/prisma

RUN npm install

# ─── Runtime config ────────────────────────────────────────────
WORKDIR /app/apps/web

# File watcher polling — required for reliable hot reload on
# Windows/Mac Docker Desktop (filesystem events don't cross the VM).
ENV WATCHPACK_POLLING=true
ENV CHOKIDAR_USEPOLLING=true

EXPOSE 3000

# Next.js dev server with hot module reload
CMD ["npm", "run", "dev"]
